# frozen_string_literal: true

# GitHub Pages builds this site itself, so this Gemfile only exists so you can
# preview locally:
#
#   bundle install
#   bundle exec jekyll serve --livereload
#
# The `github-pages` gem pins Jekyll and every plugin to exactly the versions
# GitHub Pages runs, so what you see locally is what gets published.

source 'https://rubygems.org'

# gem 'github-pages', group: :jekyll_plugins
gem 'jekyll', '~> 4.3'
gem 'jekyll-seo-tag'
gem 'jekyll-sitemap'
gem 'webrick'
gem 'bigdecimal'

# Required on Ruby 3.0+ — these left the standard library.
gem 'csv'
